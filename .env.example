# DEVELOPMENT ONLY.
# Copy this file to `.env` and keep real credentials out of source control.

APP_ENV=development
APP_VERSION=0.0.0-dev
APP_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://intelligence:local-postgres-change-me@127.0.0.1:5432/intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Replace these non-routable examples with the deployment's trusted OIDC values.
OIDC_ISSUER=https://identity.example.invalid
OIDC_AUDIENCE=intelligence-platform-api
OIDC_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_SERVICE_CLIENT_IDS=connector-worker,intelligence-worker,indexing-worker
