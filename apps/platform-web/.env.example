# Copy to apps/platform-web/.env.local. Never commit real values.
# WEB_* values are server-only; do not rename to NEXT_PUBLIC_*.
WEB_ORIGIN=http://localhost:3000
WEB_PLATFORM_API_URL=http://localhost:3001/api/v1
WEB_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
WEB_OIDC_CLIENT_ID=
# Auth0 API Identifier; must equal the API's OIDC_AUDIENCE, not the web Client ID.
WEB_OIDC_AUDIENCE=intelligence-platform-api
# Auth0 Regular Web Application secret; configure token endpoint auth as POST.
# Never paste the secret into chat. Inject it only in the web server environment.
WEB_OIDC_CLIENT_SECRET=
WEB_OIDC_SCOPE=openid
# Supply a random 32-byte hexadecimal key (64 characters) through your secret manager.
# No default key exists. All web replicas must use the same key.
WEB_SESSION_KEY=
