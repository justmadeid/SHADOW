{
  "name": "intelligence-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint apps packages tooling e2e --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node tooling/architecture-boundaries/check-boundaries.mjs",
    "test:boundaries": "node --test tooling/architecture-boundaries/check-boundaries.test.mjs",
    "check:deps": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err",
    "check:architecture": "pnpm check:boundaries && pnpm test:boundaries && pnpm check:deps",
    "test": "vitest run --config tooling/testing/vitest.unit.config.ts",
    "test:watch": "vitest --config tooling/testing/vitest.unit.config.ts",
    "test:coverage": "vitest run --coverage --config tooling/testing/vitest.unit.config.ts",
    "test:integration": "vitest run --config tooling/testing/vitest.integration.config.ts",
    "test:contract": "vitest run --config tooling/testing/vitest.contract.config.ts",
    "test:e2e": "playwright test --config tooling/testing/playwright.config.ts",
    "dev:infra": "docker compose --env-file infrastructure/compose/.env.infrastructure -f infrastructure/compose/docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose --env-file infrastructure/compose/.env.infrastructure -f infrastructure/compose/docker-compose.dev.yml down",
    "dev:infra:reset": "docker compose --env-file infrastructure/compose/.env.infrastructure -f infrastructure/compose/docker-compose.dev.yml down -v --remove-orphans",
    "dev:infra:logs": "docker compose --env-file infrastructure/compose/.env.infrastructure -f infrastructure/compose/docker-compose.dev.yml logs -f",
    "dev:infra:check": "node --env-file=infrastructure/compose/.env.infrastructure tooling/dev/check-infra.mjs",
    "migrations:validate": "node tooling/ci/validate-migrations.mjs",
    "db:migrate": "node --env-file=.env tooling/db/migrate.mjs",
    "contracts:lint": "redocly lint docs/contracts/platform-api-v1.yaml",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:secrets": "docker run --rm -v \"$PWD:/repo:ro\" zricethezav/gitleaks@sha256:cdbb7c955abce02001a9f6c9f602fb195b7fadc1e812065883f695d1eeaba854 detect --source=/repo --no-git --redact --config=/repo/.gitleaks.toml",
    "m0:static": "pnpm check:architecture && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contract && pnpm migrations:validate && pnpm contracts:lint && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@next/eslint-plugin-next": "15.5.24",
    "@playwright/test": "^1.55.0",
    "@redocly/cli": "^2.49.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
