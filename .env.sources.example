# Source/connector development configuration.
# Copy to .env.sources only when connector work begins.
# Never commit real API keys.

# Existing local/internal service URLs must be replaced with actual discovered ports.
PERSON_LOOKUP_API_BASE_URL=
# Alias/repository: leaked-service (Hono API)
USER_SCANNER_BASE_URL=
TWITTER_SCRAPPER_API_BASE_URL=

# External OSINT Industries API
