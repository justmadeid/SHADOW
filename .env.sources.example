OSINT_INDUSTRIES_API_KEY=
OSINT_INDUSTRIES_TIMEOUT_SECONDS=60
OSINT_INDUSTRIES_EXACT_MATCH=true
OSINT_INDUSTRIES_PREMIUM=false
